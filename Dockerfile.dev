# syntax=docker/dockerfile:1

# ============================================
# Development Dockerfile for Link-It
# Optimized for hot-reload with volume mounts
# ============================================

FROM node:20-slim

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install all dependencies (including devDependencies)
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Copy config files needed for dev server
COPY next.config.mjs tsconfig.json tailwind.config.ts postcss.config.mjs ./
COPY components.json ./

# Source code will be mounted via volumes in docker-compose.dev.yml

# Set development environment
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Expose the port
EXPOSE 3000

# Start the dev server
CMD ["pnpm", "dev"]
