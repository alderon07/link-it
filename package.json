{
  "name": "link-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "npm-run-all --parallel dev:next convex:dev",
    "dev:next": "next dev",
    "convex:dev": "convex dev",
    "build": "next build",
    "build:convex": "convex deploy --cmd 'next build'",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "scan": "next dev & npx react-scan@latest localhost:3000",
    "docker:build": "docker build -t link-it .",
    "docker:run": "docker run -p 3000:3000 --env-file .env link-it",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:prod": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@clerk/nextjs": "7.0.0-canary.v20260113005528",
    "@clerk/themes": "^2.2.46",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.26.1",
    "isomorphic-dompurify": "^2.35.0",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.6",
    "next": "^16",
    "posthog-js": "^1.319.0",
    "posthog-node": "^5.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scan": "^0.3.3",
    "recharts": "^3.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "svix": "^1.84.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "happy-dom": "^20.3.7",
    "jsdom": "^27.4.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.1+sha256.52128de921542b1faa91c4c7dec5e88c5736ccb6006b879401e90db275ee4719"
